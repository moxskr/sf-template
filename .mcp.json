{
	"mcpServers": {
		"Salesforce DX": {
			"command": "npx",
			"args": [
				"-y",
				"@salesforce/mcp@latest",
				"--orgs",
				"DEFAULT_TARGET_ORG,DEFAULT_TARGET_DEV_HUB",
				"--toolsets",
				"orgs,metadata,data,users,lwc-experts,testing,code-analysis,experts-validation,scale-products",
				"--tools",
				"run_apex_test",
				"--allow-non-ga-tools"
			]
		}
	}
}
