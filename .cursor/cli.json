{
	"permissions": {
		"allow": [
			"Shell(sf)",
			"Shell(npm)",
			"Shell(npx)",
			"Shell(node)",
			"Shell(git)",
			"Shell(ls)",
			"Shell(pwd)",
			"Shell(cat)",
			"Shell(rg)",
			"Shell(uv)",
			"Shell(python)",
			"Shell(python3)",
			"Read(**)",
			"Write(force-app/**)",
			"Write(config/**)",
			"Write(scripts/**)",
			"Write(manifest/**)",
			"Write(*.json)",
			"Write(*.md)",
			"Write(*.js)",
			"Write(*.ts)",
			"Write(*.cls)",
			"Write(*.trigger)",
			"Write(*.xml)",
			"Write(*.css)",
			"Write(*.html)",
			"Write(*.apex)",
			"Write(*.soql)",
			"Mcp(Salesforce DX:*)",
			"WebFetch(developer.salesforce.com)",
			"WebFetch(*.salesforce.com)"
		],
		"deny": [
			"Read(**/.env*)",
			"Read(**/*.key)",
			"Read(**/*.pem)",
			"Read(**/.ssh/**)",
			"Write(**/.env*)",
			"Write(**/*.key)",
			"Write(**/*.pem)",
			"Shell(sudo)",
			"Shell(rm:-rf /)",
			"Shell(rm:-rf ~)"
		]
	}
}
