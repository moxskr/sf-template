{
	"editor.tabSize": 4,
	"editor.insertSpaces": false,
	"editor.detectIndentation": false,
	"python.languageServer": "None",
	"salesforcedx-vscode-core.push-or-deploy-on-save.enabled": false,
	"salesforcedx-vscode-apex.java.home": "${env:JAVA_HOME}",
	"search.exclude": {
		"**/node_modules": true,
		"**/bower_components": true,
		"**/.sf": true,
		"**/.sfdx": true,
		"**/.venv": true,
		"**/venv": true,
		"**/__pycache__": true,
		"**/.pytest_cache": true,
		"**/.mypy_cache": true,
		"**/.ruff_cache": true,
		"**/coverage": true,
		"**/.localdevserver": true,
		"**/dist": true,
		"**/build": true,
		"**/.git": true,
		"**/package-lock.json": true
	},
	"files.watcherExclude": {
		"**/node_modules/**": true,
		"**/.sf/**": true,
		"**/.sfdx/**": true,
		"**/.venv/**": true,
		"**/venv/**": true,
		"**/__pycache__/**": true,
		"**/.pytest_cache/**": true,
		"**/.mypy_cache/**": true,
		"**/.ruff_cache/**": true,
		"**/coverage/**": true,
		"**/.localdevserver/**": true,
		"**/dist/**": true,
		"**/build/**": true,
		"**/.git/objects/**": true,
		"**/.git/subtree-cache/**": true
	},
	"files.exclude": {
		"**/.sf": true,
		"**/.sfdx": true,
		"**/.venv": true,
		"**/__pycache__": true
	}
}
